# Backend Application Environment Variables
# NEVER commit the actual `.env` to Git, copy this to `.env` and fill it out.

# Core Settings
PROJECT_NAME="Agentic Finance Advisor API"

# Security (Crucial for production - Generate a strong key)
# Run `openssl rand -hex 32` to get a good secret key
SECRET_KEY=algofest_dev_secret_key_change_me

# Database 
# For Local Dev (SQLite): sqlite+aiosqlite:///./algofest.db
# For Production (PostgreSQL): postgresql+asyncpg://user:password@host/db_name
DATABASE_URL=sqlite+aiosqlite:///./algofest.db

# API Key for LLM
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Restrict CORS (Comma-separated listed domains)
# Example: https://algofest.vercel.app,http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000